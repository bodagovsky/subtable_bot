# Telegram webhook bridge
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-domain.example
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443
WEBHOOK_SECRET_TOKEN=

# MTProto is used only to retrieve message text on demand through MCP.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Redis stores the seven-day message index, reaction metadata, queue, and agent state.
REDISCLOUD_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# OpenAI Agents API application key. It needs api.agents.read,
# api.agents.write, and api.responses.write in proj_jCMxrtupTQBmWaQIW2kdOXHA.
OPENAI_API_KEY=

# Public HTTPS endpoint for the Streamable HTTP MCP server. Put it behind a
# reverse proxy that validates this bearer token before forwarding to port 8000.
TELEGRAM_MCP_URL=https://mcp.your-domain.example/mcp
TELEGRAM_MCP_AUTH_TOKEN=
TELEGRAM_MCP_HOST=127.0.0.1
TELEGRAM_MCP_PORT=8000

# Limit the Telegram MCP server to chats controlled by this deployment.
TELEGRAM_MCP_ALLOWED_CHAT_IDS=-1001234567890
# TELEGRAM_MCP_READ_ONLY=true
